<!--
================================================================================
 TEE PortChecker - Ergebniskarte zum Teilen
================================================================================
 Zeigt eine Vorschau der Karte und legt sie beim Öffnen sofort in die
 Zwischenablage. Damit lässt sie sich direkt in Discord einfügen.

 DATENSCHUTZ - der Grund für die Maskierung:
   Diese Karte ist zum Weitergeben gedacht. Die vollständige öffentliche
   IP-Adresse gehört deshalb NICHT darauf. Sie wird auf die ersten beiden
   Blöcke gekürzt (203.0.xxx.xxx) - das reicht, um den Anbieter grob
   einzuordnen, taugt aber nicht dazu, jemanden anzugreifen.

 Der Bereich mit x:Name="ShareCard" ist genau das, was als Bild gespeichert
 wird. Alles außerhalb davon ist nur Bedienung.
================================================================================
-->
<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    Title="Ergebnis teilen - TEE PortChecker"
    Height="580" Width="700"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="True"
    Background="{DynamicResource WindowBackgroundBrush}"
    TextOptions.TextFormattingMode="Ideal"
    UseLayoutRounding="True"
    FontFamily="Segoe UI Variable Text, Segoe UI"
    FontSize="13">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0"
                            CornerRadius="0" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>

        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource AccentFgBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="7" Background="{DynamicResource AccentGradientBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ShareNoteStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="16"/>
            <Setter Property="Foreground" Value="{DynamicResource FgFaintBrush}"/>
        </Style>

        <Style x:Key="ShareHintStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="17"/>
            <Setter Property="MaxWidth" Value="620"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="{DynamicResource FgFaintBrush}"/>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="7"
                                Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border x:Name="ShareTitleBar" Grid.Row="0" Background="{DynamicResource SurfaceBrush}">
                <Grid>
                    <TextBlock Text="Ergebnis teilen" VerticalAlignment="Center" Margin="14,0,0,0"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource FgFaintBrush}"/>
                    <Button x:Name="BtnShareClose" HorizontalAlignment="Right" Width="46" Height="38"
                            FontFamily="{StaticResource IconFont}" FontSize="10"
                            Content="&#xE8BB;" Foreground="{DynamicResource FgDimBrush}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="Transparent">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background"
                                                Value="{DynamicResource CloseHoverBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="26,20,26,0">
                <StackPanel>

                    <!-- ============ DIESER BEREICH WIRD ZUM BILD ============ -->
                    <Border x:Name="ShareCard" Width="620" CornerRadius="14" Padding="26,24"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5">
                        <StackPanel>
                            <!-- Kopf -->
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="40" Height="40" CornerRadius="10"
                                            Background="{DynamicResource AccentGradientBrush}">
                                        <Path Data="M 4,12 A 8,8 0 0 1 20,12 M 7.5,12 A 4.5,4.5 0 0 1 16.5,12"
                                              Stroke="{DynamicResource AccentFgBrush}" StrokeThickness="1.8"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Stretch="Uniform" Margin="9,10,9,12"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                                        <TextBlock FontFamily="{StaticResource DisplayFont}" FontSize="18">
                                            <Run Text="TEE" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/><Run Text=" PortChecker" FontWeight="SemiBold" Foreground="{DynamicResource FgBrush}"/>
                                        </TextBlock>
                                        <TextBlock x:Name="TxtShareSubtitle" Text="Port-Ergebnis" FontSize="11"
                                                   Margin="0,1,0,0"
                                                   Foreground="{DynamicResource FgFaintBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtShareIp" Text="203.0.113.xxx" FontSize="13"
                                               HorizontalAlignment="Right"
                                               FontFamily="{StaticResource MonoFont}"
                                               Foreground="{DynamicResource FgDimBrush}"/>
                                    <TextBlock x:Name="TxtShareDate" Text="" FontSize="10" Margin="0,2,0,0"
                                               HorizontalAlignment="Right"
                                               Foreground="{DynamicResource FgFaintBrush}"/>
                                </StackPanel>
                            </Grid>

                            <Border Height="1" Background="{DynamicResource StrokeBrush}" Margin="0,18,0,18"/>

                            <!-- Kennzahlen -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="OFFEN" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource FgFaintBrush}"/>
                                    <TextBlock x:Name="TxtShareOpen" Text="0" FontSize="27" FontWeight="Bold"
                                               Margin="0,3,0,0" FontFamily="{StaticResource MonoFont}"
                                               Foreground="{DynamicResource OkBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="GESCHLOSSEN" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource FgFaintBrush}"/>
                                    <TextBlock x:Name="TxtShareClosed" Text="0" FontSize="27" FontWeight="Bold"
                                               Margin="0,3,0,0" FontFamily="{StaticResource MonoFont}"
                                               Foreground="{DynamicResource BadBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="GEPRÜFT" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource FgFaintBrush}"/>
                                    <TextBlock x:Name="TxtShareTotal" Text="0" FontSize="27" FontWeight="Bold"
                                               Margin="0,3,0,0" FontFamily="{StaticResource MonoFont}"
                                               Foreground="{DynamicResource FgBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="NAT-TYP" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource FgFaintBrush}"/>
                                    <TextBlock x:Name="TxtShareNat" Text="?" FontSize="21" FontWeight="Bold"
                                               Margin="0,7,0,0" FontFamily="{StaticResource MonoFont}"
                                               Foreground="{DynamicResource WarnBrush}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Offene Ports -->
                            <Border x:Name="ShareOpenBox" Margin="0,18,0,0" CornerRadius="8" Padding="14,11"
                                    Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource StrokeSoftBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="OFFENE PORTS" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource FgFaintBrush}"/>
                                    <TextBlock x:Name="TxtShareOpenPorts" Text="-" FontSize="14" Margin="0,5,0,0"
                                               TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}"
                                               Foreground="{DynamicResource OkBrush}"/>
                                </StackPanel>
                            </Border>

                            <TextBlock x:Name="TxtShareNote" Style="{StaticResource ShareNoteStyle}" Margin="0,14,0,0"/>

                            <!-- Fuss mit Verweisen -->
                            <Border Height="1" Background="{DynamicResource StrokeBrush}" Margin="0,18,0,14"/>
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="{StaticResource IconFont}" FontSize="12" Text="&#xE71B;"
                                               VerticalAlignment="Center"
                                               TextOptions.TextFormattingMode="Display"
                                               Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock Text="linktr.ee/theersysending" FontSize="12" Margin="7,0,0,0"
                                               VerticalAlignment="Center"
                                               FontFamily="{StaticResource MonoFont}"
                                               Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock FontFamily="{StaticResource IconFont}" FontSize="12" Text="&#xE8F2;"
                                               Margin="18,0,0,0" VerticalAlignment="Center"
                                               TextOptions.TextFormattingMode="Display"
                                               Foreground="{DynamicResource FgDimBrush}"/>
                                    <TextBlock Text="discord.gg/teebug" FontSize="12" Margin="7,0,0,0"
                                               VerticalAlignment="Center"
                                               FontFamily="{StaticResource MonoFont}"
                                               Foreground="{DynamicResource FgDimBrush}"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtShareVersion" Text="v1.0.0" FontSize="11"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Foreground="{DynamicResource FgFaintBrush}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <!-- ============ ENDE DES BILDBEREICHS ============ -->

                    <TextBlock Style="{StaticResource ShareHintStyle}" Margin="0,16,0,20"
                               Text="Die Karte liegt bereits in der Zwischenablage - du kannst sie direkt mit Strg+V in Discord einfügen. Deine öffentliche IP ist absichtlich gekürzt, damit sie beim Teilen nicht mitgeht."/>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource StrokeSoftBrush}" BorderThickness="0,1,0,0"
                    Padding="26,14">
                <Grid>
                    <TextBlock x:Name="TxtShareStatus" VerticalAlignment="Center" FontSize="11"
                               Foreground="{DynamicResource OkBrush}"
                               Text="In die Zwischenablage kopiert."/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnShareCopy" Style="{StaticResource GhostButton}"
                                Content="Erneut kopieren" Margin="0,0,8,0"/>
                        <Button x:Name="BtnShareSave" Style="{StaticResource GhostButton}"
                                Content="Als Datei speichern" Margin="0,0,8,0"/>
                        <Button x:Name="BtnShareOk" Style="{StaticResource AccentButton}"
                                Content="Fertig" MinWidth="110"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
