<!--
================================================================================
 PortCheck - Oberfläche
================================================================================
 Reines XAML, zur Laufzeit geladen. Bewusst OHNE x:Class und ohne
 Event-Attribute: alle Ereignisse werden in PortCheck.Gui.ps1 per FindName
 verdrahtet. Dadurch bleibt diese Datei purer Aufbau + Aussehen und lässt
 sich verändern, ohne PowerShell anzufassen.

 Sämtliche Farben kommen per DynamicResource aus PortCheck.Themes.ps1.
 Steht hier irgendwo ein fester Farbwert, ist das ein Fehler - dann lässt
 sich das Element nicht mehr umthemen.
================================================================================
-->
<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    Title="PortCheck"
    Height="780" Width="1240"
    MinHeight="660" MinWidth="1040"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    Background="{DynamicResource WindowBackgroundBrush}"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="ClearType"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    FontFamily="Segoe UI Variable Text, Segoe UI"
    FontSize="13">

    <shell:WindowChrome.WindowChrome>
        <!-- CaptionHeight=0: die Titelleiste bauen wir selbst.
             ResizeBorderThickness sorgt dafür, dass die Ränder trotzdem
             zum Größenändern greifen. -->
        <shell:WindowChrome
            CaptionHeight="0"
            ResizeBorderThickness="6"
            CornerRadius="0"
            GlassFrameThickness="0"
            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>

        <!-- ============================================================== -->
        <!-- Grundwerte                                                     -->
        <!-- ============================================================== -->
        <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>

        <!-- ============================================================== -->
        <!-- Text                                                           -->
        <!-- ============================================================== -->
        <Style x:Key="H1" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        </Style>

        <Style x:Key="H2" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
        </Style>

        <Style x:Key="Body" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource FgDimBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="19"/>
        </Style>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource FgFaintBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource FgFaintBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="Mono" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
        </Style>

        <Style x:Key="MonoBig" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="21"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
        </Style>

        <Style x:Key="Icon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- ============================================================== -->
        <!-- Bildlaufleisten - schlank im Windows-11-Stil                   -->
        <!-- ============================================================== -->
        <Style x:Key="ScrollThumb" TargetType="Thumb">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Bd" Background="{DynamicResource ScrollBrush}"
                                CornerRadius="3" Margin="3,0"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ScrollHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="12"/>
            <Setter Property="MinWidth" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Height" Value="12"/>
                                <Setter Property="MinHeight" Value="12"/>
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollViewer">
            <Setter Property="PanningMode" Value="VerticalOnly"/>
        </Style>

        <!-- ============================================================== -->
        <!-- Schaltflächen                                                 -->
        <!-- ============================================================== -->
        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource AccentFgBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Glow" CornerRadius="7" Background="{DynamicResource AccentBrush}"
                                    Opacity="0">
                                <Border.Effect>
                                    <BlurEffect Radius="14"/>
                                </Border.Effect>
                            </Border>
                            <Border x:Name="Bd" CornerRadius="7" Background="{DynamicResource AccentGradientBrush}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Glow" Property="Opacity" Value="0.55"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                                <Setter TargetName="Glow" Property="Opacity" Value="0.2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.3"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="7"
                                Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                                <Setter Property="Foreground" Value="{DynamicResource FgFaintBrush}"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Foreground" Value="{DynamicResource BadBrush}"/>
        </Style>

        <!-- Titelleisten-Schaltflächen: exakt Windows-11-Maße (46x32) -->
        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Foreground" Value="{DynamicResource FgDimBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CloseHoverBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Navigationseinträge in der Seitenleiste -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="8,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource FgDimBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="Bd" CornerRadius="7" Background="Transparent"/>
                            <Border x:Name="Bar" Width="3" Height="20" CornerRadius="2"
                                    HorizontalAlignment="Left" Margin="1,0,0,0"
                                    Background="{DynamicResource AccentBrush}" Opacity="0"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                                <TextBlock x:Name="Ico" Style="{StaticResource Icon}" FontSize="16"
                                           Text="{TemplateBinding Tag}" Width="22"
                                           Foreground="{DynamicResource FgFaintBrush}"/>
                                <ContentPresenter VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                <Setter TargetName="Bar" Property="Opacity" Value="1"/>
                                <Setter TargetName="Ico" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Kleine Auswahl-Chips (Schnellauswahl bei den Ports) -->
        <Style x:Key="Chip" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource FgDimBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="13" Padding="12,5"
                                Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource StrokeSoftBrush}" BorderThickness="1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================================== -->
        <!-- Eingabefelder                                                  -->
        <!-- ============================================================== -->
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" CornerRadius="7"
                                Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"/>
                                <TextBlock x:Name="Ph" Text="{TemplateBinding Tag}" IsHitTestVisible="False"
                                           Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource FgFaintBrush}" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Ph" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource FgFaintBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1.6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox: eigener Aufbau, sonst bleibt das graue Windows-Aussehen -->
        <ControlTemplate x:Key="ComboToggle" TargetType="ToggleButton">
            <Border x:Name="Bd" CornerRadius="7"
                    Background="{DynamicResource SurfaceAltBrush}"
                    BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="30"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Style="{StaticResource Icon}" FontSize="11"
                               Text="&#xE70D;" Foreground="{DynamicResource FgDimBrush}"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
            <Setter Property="Padding" Value="11,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Margin="4,1">
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Template="{StaticResource ComboToggle}" Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"/>
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="12,0,32,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade"
                                   Focusable="False" VerticalOffset="4">
                                <Border Background="{DynamicResource SurfaceAltBrush}"
                                        BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                                        CornerRadius="8" MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="320" Padding="0,4">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.5"
                                                          Color="{DynamicResource ShadowColor}"/>
                                    </Border.Effect>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CheckBox im Windows-11-Stil -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="20" Height="20" CornerRadius="5"
                                    Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1.4"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="Tick" Style="{StaticResource Icon}" FontSize="11"
                                           Text="&#xE73E;" Foreground="{DynamicResource AccentFgBrush}"
                                           Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Schieberegler -->
        <Style TargetType="Slider">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="4" CornerRadius="2" Background="{DynamicResource StrokeBrush}"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2"
                                                        Background="{DynamicResource AccentBrush}"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="18" Height="18">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid>
                                                    <Ellipse Fill="{DynamicResource FgBrush}"/>
                                                    <Ellipse Fill="{DynamicResource AccentBrush}" Margin="4"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fortschrittsbalken -->
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border CornerRadius="3" Background="{DynamicResource StrokeSoftBrush}"
                                ClipToBounds="True">
                            <Grid>
                                <Rectangle x:Name="PART_Track"/>
                                <Rectangle x:Name="PART_Indicator" HorizontalAlignment="Left"
                                           Fill="{DynamicResource AccentGradientBrush}" RadiusX="3" RadiusY="3"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================================== -->
        <!-- Karten                                                         -->
        <!-- ============================================================== -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18"/>
        </Style>

        <Style x:Key="StatCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
        </Style>

        <!-- ============================================================== -->
        <!-- Ergebnisliste                                                  -->
        <!-- ============================================================== -->
        <Style x:Key="ResultHeader" TargetType="GridViewColumnHeader">
            <Setter Property="Foreground" Value="{DynamicResource FgFaintBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Border x:Name="Bd" Background="Transparent" Padding="12,9"
                                BorderBrush="{DynamicResource StrokeSoftBrush}" BorderThickness="0,0,0,1">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ResultRow" TargetType="ListViewItem">
            <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Margin="2,1">
                            <GridViewRowPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlainList" TargetType="ListView">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>

        <!-- ============================================================== -->
        <!-- Preset-Karte (anklickbar, mehrfach auswählbar)                -->
        <!-- ============================================================== -->
        <Style x:Key="PresetCard" TargetType="ToggleButton">
            <Setter Property="Width" Value="232"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" CornerRadius="10" Padding="14,12"
                                Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold"
                                               FontSize="13" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource FgBrush}"/>
                                    <Border x:Name="Check" Grid.Column="1" Width="18" Height="18" CornerRadius="9"
                                            Background="{DynamicResource AccentBrush}" Opacity="0"
                                            VerticalAlignment="Top">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="9"
                                                   Foreground="{DynamicResource AccentFgBrush}"/>
                                    </Border>
                                </Grid>

                                <TextBlock Grid.Row="1" Text="{Binding SubText}" FontSize="11" Margin="0,3,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource FgFaintBrush}"/>

                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="4"
                                            Padding="7,2" Margin="0,0,6,0">
                                        <TextBlock Text="{Binding TcpText}" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentBrush}"/>
                                    </Border>
                                    <Border Background="{DynamicResource StrokeSoftBrush}" CornerRadius="4"
                                            Padding="7,2">
                                        <TextBlock Text="{Binding UdpText}" FontSize="10"
                                                   Foreground="{DynamicResource FgFaintBrush}"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource FgFaintBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1.6"/>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                <Setter TargetName="Check" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="PresetTemplate">
            <ToggleButton Style="{StaticResource PresetCard}"
                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                          ToolTip="{Binding Tip}"/>
        </DataTemplate>

        <!-- ============================================================== -->
        <!-- Theme-Karte                                                    -->
        <!-- ============================================================== -->
        <Style x:Key="ThemeCard" TargetType="RadioButton">
            <Setter Property="Width" Value="186"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="GroupName" Value="ThemeChoice"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="9" Padding="12,10"
                                Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="34" Height="34" CornerRadius="7"
                                            Background="{Binding SwatchBg}"
                                            BorderBrush="{Binding SwatchStroke}" BorderThickness="1">
                                        <Grid>
                                            <Ellipse Width="13" Height="13" Fill="{Binding SwatchAccent}"
                                                     HorizontalAlignment="Left" VerticalAlignment="Center"
                                                     Margin="4,0,0,0"/>
                                            <Ellipse Width="13" Height="13" Fill="{Binding SwatchAccent2}"
                                                     HorizontalAlignment="Right" VerticalAlignment="Center"
                                                     Margin="0,0,4,0"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                                   Foreground="{DynamicResource FgBrush}"/>
                                        <TextBlock Text="{Binding Tagline}" FontSize="10" Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource FgFaintBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource FgFaintBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1.8"/>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ThemeTemplate">
            <RadioButton Style="{StaticResource ThemeCard}"
                         IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
        </DataTemplate>

        <!-- ============================================================== -->
        <!-- Werkzeugtipps                                                  -->
        <!-- ============================================================== -->
        <Style TargetType="ToolTip">
            <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="10,7" MaxWidth="340">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ================================================================== -->
    <!-- Aufbau                                                             -->
    <!-- ================================================================== -->
    <Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <!-- ============================================================ -->
            <!-- Titelleiste                                                -->
            <!-- ============================================================ -->
            <Border x:Name="TitleBar" Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource StrokeSoftBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0,0,0"
                                VerticalAlignment="Center">
                        <Border Width="24" Height="24" CornerRadius="6"
                                Background="{DynamicResource AccentGradientBrush}">
                            <Path Data="M 4,12 A 8,8 0 0 1 20,12 M 7.5,12 A 4.5,4.5 0 0 1 16.5,12"
                                  Stroke="{DynamicResource AccentFgBrush}" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stretch="Uniform" Margin="5,6,5,7"/>
                        </Border>
                        <TextBlock Text="PortCheck" FontFamily="{StaticResource DisplayFont}"
                                   FontSize="13" FontWeight="SemiBold" Margin="10,0,0,0"
                                   VerticalAlignment="Center" Foreground="{DynamicResource FgBrush}"/>
                        <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="4"
                                Padding="6,2" Margin="9,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtVersionChip" Text="v2.0" FontSize="10"
                                       Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="BtnMinimize" Style="{StaticResource TitleBarButton}"
                                Content="&#xE921;" ToolTip="Minimieren"/>
                        <Button x:Name="BtnMaximize" Style="{StaticResource TitleBarButton}"
                                Content="&#xE922;" ToolTip="Maximieren"/>
                        <Button x:Name="BtnClose" Style="{StaticResource CloseButton}"
                                Content="&#xE8BB;" ToolTip="Schließen"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================================================ -->
            <!-- Hauptbereich                                               -->
            <!-- ============================================================ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="228"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Seitenleiste -->
                <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource StrokeSoftBrush}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,12,0,0">
                            <TextBlock Text="PRÜFEN" Style="{StaticResource Label}" Margin="22,6,0,8"/>
                            <RadioButton x:Name="NavDashboard" Style="{StaticResource NavItem}"
                                         GroupName="Nav" Tag="&#xE80F;" Content="Übersicht" IsChecked="True"/>
                            <RadioButton x:Name="NavPorts" Style="{StaticResource NavItem}"
                                         GroupName="Nav" Tag="&#xE9D9;" Content="Port-Test"/>
                            <RadioButton x:Name="NavPresets" Style="{StaticResource NavItem}"
                                         GroupName="Nav" Tag="&#xE7FC;" Content="Spiele-Presets"/>
                            <RadioButton x:Name="NavNat" Style="{StaticResource NavItem}"
                                         GroupName="Nav" Tag="&#xE774;" Content="NAT-Typ"/>

                            <TextBlock Text="SYSTEM" Style="{StaticResource Label}" Margin="22,18,0,8"/>
                            <RadioButton x:Name="NavNetwork" Style="{StaticResource NavItem}"
                                         GroupName="Nav" Tag="&#xE839;" Content="Netzwerk"/>
                            <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}"
                                         GroupName="Nav" Tag="&#xE713;" Content="Einstellungen"/>
                            <RadioButton x:Name="NavAbout" Style="{StaticResource NavItem}"
                                         GroupName="Nav" Tag="&#xE946;" Content="Über &amp; Hilfe"/>
                        </StackPanel>

                        <!-- Fuß der Seitenleiste: eigene IP immer im Blick -->
                        <Border Grid.Row="1" Margin="12" CornerRadius="8" Padding="12,10"
                                Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource StrokeSoftBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="ÖFFENTLICHE IP" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                                <TextBlock x:Name="TxtSideIp" Text="wird ermittelt..."
                                           Style="{StaticResource Mono}" FontSize="12"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Ellipse x:Name="DotNat" Width="7" Height="7" VerticalAlignment="Center"
                                             Fill="{DynamicResource FgFaintBrush}"/>
                                    <TextBlock x:Name="TxtSideNat" Text="NAT unbekannt" Margin="7,0,0,0"
                                               Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Seitenbereich -->
                <Grid Grid.Column="1">

                    <!-- ===================== ÜBERSICHT ===================== -->
                    <ScrollViewer x:Name="PageDashboard" VerticalScrollBarVisibility="Auto" Padding="28,24,20,24">
                        <StackPanel>
                            <TextBlock Text="Übersicht" Style="{StaticResource H1}"/>
                            <TextBlock Style="{StaticResource Body}" Margin="0,6,0,20" MaxWidth="760"
                                       HorizontalAlignment="Left"
                                       Text="Auf einen Blick: wie dein Anschluss von außen aussieht. Alles hier wird live gemessen, nichts geraten."/>

                            <WrapPanel>
                                <Border Style="{StaticResource StatCard}" Width="224">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE774;" FontSize="13"
                                                       Foreground="{DynamicResource AccentBrush}"/>
                                            <TextBlock Text="ÖFFENTLICHE IP" Style="{StaticResource Label}"
                                                       Margin="7,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock x:Name="TxtPublicIp" Text="..." Style="{StaticResource MonoBig}"
                                                   Margin="0,8,0,0"/>
                                        <TextBlock x:Name="TxtPublicIpNote" Style="{StaticResource Caption}"
                                                   Text="So sieht dich das Internet" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource StatCard}" Width="224">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE839;" FontSize="13"
                                                       Foreground="{DynamicResource AccentBrush}"/>
                                            <TextBlock Text="LOKALE IP" Style="{StaticResource Label}" Margin="7,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock x:Name="TxtLocalIp" Text="..." Style="{StaticResource MonoBig}"
                                                   Margin="0,8,0,0"/>
                                        <TextBlock x:Name="TxtGateway" Style="{StaticResource Caption}"
                                                   Text="Router: ..." Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource StatCard}" Width="224">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE945;" FontSize="13"
                                                       Foreground="{DynamicResource AccentBrush}"/>
                                            <TextBlock Text="NAT-TYP" Style="{StaticResource Label}" Margin="7,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock x:Name="TxtDashNat" Text="ungeprüft" Style="{StaticResource MonoBig}"
                                                   Margin="0,8,0,0"/>
                                        <TextBlock x:Name="TxtDashNatNote" Style="{StaticResource Caption}"
                                                   Text="Test im Reiter NAT-Typ" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource StatCard}" Width="224">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE71B;" FontSize="13"
                                                       Foreground="{DynamicResource AccentBrush}"/>
                                            <TextBlock Text="UPNP" Style="{StaticResource Label}" Margin="7,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock x:Name="TxtDashUpnp" Text="ungeprüft" Style="{StaticResource MonoBig}"
                                                   Margin="0,8,0,0"/>
                                        <TextBlock x:Name="TxtDashUpnpNote" Style="{StaticResource Caption}"
                                                   Text="Router-Portfreigabe auf Zuruf" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </WrapPanel>

                            <!-- Schnellstart -->
                            <Border Style="{StaticResource Card}" Margin="0,10,12,0">
                                <StackPanel>
                                    <TextBlock Text="Schnellstart" Style="{StaticResource H2}"/>
                                    <TextBlock Style="{StaticResource Body}" Margin="0,6,0,14"
                                               Text="Der übliche Weg: erst NAT-Typ messen, dann die Ports deines Spiels prüfen."/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="BtnQuickNat" Style="{StaticResource AccentButton}"
                                                Content="NAT-Typ jetzt messen"/>
                                        <Button x:Name="BtnQuickPresets" Style="{StaticResource GhostButton}"
                                                Content="Spiel auswählen" Margin="10,0,0,0"/>
                                        <Button x:Name="BtnQuickRefresh" Style="{StaticResource GhostButton}"
                                                Content="Werte neu laden" Margin="10,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Ehrliche Einordnung -->
                            <Border Style="{StaticResource Card}" Margin="0,12,12,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" FontSize="14"
                                                   Foreground="{DynamicResource WarnBrush}"/>
                                        <TextBlock Text="Was dieses Werkzeug kann - und was nicht"
                                                   Style="{StaticResource H2}" Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Body}" Margin="0,10,0,0" TextWrapping="Wrap"
                                               Text="Zuverlässig prüfbar ist nur TCP. Ob ein UDP-Port offen ist, lässt sich von außen grundsätzlich nicht sicher feststellen - es kommt schlicht keine Antwort zurück, egal ob offen oder zu. Da die meisten Spiele UDP nutzen, ist der NAT-Typ-Test die aussagekräftigere Messung."/>
                                    <TextBlock Style="{StaticResource Body}" Margin="0,8,0,0" TextWrapping="Wrap"
                                               Text="Der Port-Test braucht einen Rechner außerhalb deines Netzes. Dabei werden deine öffentliche IP und die Portnummer an einen fremden Dienst übertragen. Anders geht es technisch nicht - deshalb steht es hier offen und nicht im Kleingedruckten."/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ===================== PORT-TEST ===================== -->
                    <Grid x:Name="PagePorts" Visibility="Collapsed" Margin="28,24,20,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Port-Test" Style="{StaticResource H1}"/>
                            <TextBlock Style="{StaticResource Body}" Margin="0,6,0,16"
                                       Text="Einzelne Ports, Bereiche oder beides gemischt - z. B. 80,443,3074 oder 27000-27050."/>
                        </StackPanel>

                        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,8,14">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtPortSpec" Grid.Column="0" Height="38"
                                             Tag="z. B. 80,443,3074 oder 27000-27050"
                                             FontFamily="{StaticResource MonoFont}"/>
                                    <Button x:Name="BtnStart" Grid.Column="1" Style="{StaticResource AccentButton}"
                                            Content="Test starten" Margin="10,0,0,0" Height="38"/>
                                    <Button x:Name="BtnStop" Grid.Column="2" Style="{StaticResource DangerButton}"
                                            Content="Abbrechen" Margin="8,0,0,0" Height="38" IsEnabled="False"/>
                                </Grid>

                                <TextBlock Text="SCHNELLAUSWAHL" Style="{StaticResource Label}" Margin="0,16,0,8"/>
                                <WrapPanel x:Name="PanelChips"/>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <ProgressBar x:Name="ProgPorts" Minimum="0" Maximum="100" Value="0"/>
                                        <TextBlock x:Name="TxtPortProgress" Style="{StaticResource Caption}"
                                                   Margin="0,7,0,0" Text="Bereit."/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0"
                                                VerticalAlignment="Center">
                                        <Border Background="{DynamicResource OkSoftBrush}" CornerRadius="6"
                                                Padding="10,5" Margin="0,0,6,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="OFFEN " Style="{StaticResource Caption}"
                                                           Foreground="{DynamicResource OkBrush}" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TxtCountOpen" Text="0" FontWeight="Bold"
                                                           Foreground="{DynamicResource OkBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{DynamicResource BadSoftBrush}" CornerRadius="6"
                                                Padding="10,5" Margin="0,0,6,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="ZU " Style="{StaticResource Caption}"
                                                           Foreground="{DynamicResource BadBrush}" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TxtCountClosed" Text="0" FontWeight="Bold"
                                                           Foreground="{DynamicResource BadBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{DynamicResource WarnSoftBrush}" CornerRadius="6"
                                                Padding="10,5">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="? " Style="{StaticResource Caption}"
                                                           Foreground="{DynamicResource WarnBrush}" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TxtCountOther" Text="0" FontWeight="Bold"
                                                           Foreground="{DynamicResource WarnBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,8,0" Padding="8,14,8,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="10,0,10,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Ergebnisse" Style="{StaticResource H2}"
                                               VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <ComboBox x:Name="CmbFilter" Width="150" Margin="0,0,8,0"/>
                                        <Button x:Name="BtnCopyOpen" Style="{StaticResource GhostButton}"
                                                Content="Offene kopieren" Margin="0,0,8,0"/>
                                        <Button x:Name="BtnExport" Style="{StaticResource GhostButton}"
                                                Content="Exportieren" Margin="0,0,8,0"/>
                                        <Button x:Name="BtnClearResults" Style="{StaticResource GhostButton}"
                                                Content="Leeren"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="1">
                                    <ListView x:Name="LstResults" Style="{StaticResource PlainList}"
                                              ItemContainerStyle="{StaticResource ResultRow}">
                                        <ListView.View>
                                            <GridView ColumnHeaderContainerStyle="{StaticResource ResultHeader}">
                                                <GridViewColumn Header="Port" Width="90">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Port}" FontFamily="Cascadia Mono, Consolas"
                                                                       FontSize="13" Margin="12,7"
                                                                       Foreground="{DynamicResource FgBrush}"/>
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                                <GridViewColumn Header="Status" Width="150">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{Binding StatusBg}" CornerRadius="5"
                                                                    Padding="9,3" Margin="10,5" HorizontalAlignment="Left">
                                                                <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{Binding StatusFg}"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                                <GridViewColumn Header="Dienst" Width="150">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Provider}" Margin="12,7" FontSize="12"
                                                                       Foreground="{DynamicResource FgDimBrush}"/>
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                                <GridViewColumn Header="Dauer" Width="90">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding DurationText}" Margin="12,7" FontSize="12"
                                                                       FontFamily="Cascadia Mono, Consolas"
                                                                       Foreground="{DynamicResource FgFaintBrush}"/>
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                                <GridViewColumn Header="Hinweis" Width="420">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Note}" Margin="12,7" FontSize="12"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding Note}"
                                                                       Foreground="{DynamicResource FgFaintBrush}"/>
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                            </GridView>
                                        </ListView.View>
                                    </ListView>

                                    <TextBlock x:Name="TxtNoResults" Style="{StaticResource Body}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               TextAlignment="Center" MaxWidth="380"
                                               Text="Noch keine Ergebnisse. Ports eingeben oder oben eine Schnellauswahl anklicken."/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ===================== PRESETS ===================== -->
                    <Grid x:Name="PagePresets" Visibility="Collapsed" Margin="28,24,20,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Spiele-Presets" Style="{StaticResource H1}"/>
                            <TextBlock x:Name="TxtPresetIntro" Style="{StaticResource Body}" Margin="0,6,0,16"
                                       Text="Fertige Portlisten aus den offiziellen Hersteller-Angaben. Konsolen-Einträge enthalten automatisch die Basisports der Plattform."/>
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,0,8,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="CmbCategory" Grid.Column="0"/>
                            <TextBox x:Name="TxtPresetSearch" Grid.Column="1" Margin="10,0,0,0" Height="36"
                                     Tag="Suchen: Spiel, Hersteller oder Plattform"/>
                        </Grid>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,8,0">
                            <ItemsControl x:Name="ItemsPresets" ItemTemplate="{StaticResource PresetTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>

                        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,14,8,0" Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtPresetSelection" Style="{StaticResource Body}"
                                               Text="Nichts ausgewählt."/>
                                    <TextBlock x:Name="TxtPresetUdp" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="BtnPresetClear" Style="{StaticResource GhostButton}"
                                            Content="Auswahl leeren" Margin="0,0,8,0"/>
                                    <Button x:Name="BtnPresetTest" Style="{StaticResource AccentButton}"
                                            Content="Ausgewählte testen" IsEnabled="False"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ===================== NAT-TYP ===================== -->
                    <ScrollViewer x:Name="PageNat" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                                  Padding="28,24,20,24">
                        <StackPanel>
                            <TextBlock Text="NAT-Typ" Style="{StaticResource H1}"/>
                            <TextBlock Style="{StaticResource Body}" Margin="0,6,0,18" MaxWidth="820"
                                       HorizontalAlignment="Left"
                                       Text="Misst mit derselben Technik, die Spiele und Videochats benutzen (STUN): mehrere Server im Internet melden zurück, unter welcher Adresse sie dich sehen. Stimmen alle überein, ist dein Router gutmütig - weichen sie ab, ist er streng."/>

                            <Border x:Name="NatResultCard" Style="{StaticResource Card}" Margin="0,0,12,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border x:Name="NatBadge" Grid.Column="0" Width="128" Height="128"
                                            CornerRadius="14" Background="{DynamicResource SurfaceAltBrush}"
                                            BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1.5">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="NatBadgeIcon" Style="{StaticResource Icon}"
                                                       Text="&#xE9CE;" FontSize="34"
                                                       Foreground="{DynamicResource FgFaintBrush}"/>
                                            <TextBlock x:Name="NatBadgeText" Text="?" FontSize="17" FontWeight="Bold"
                                                       HorizontalAlignment="Center" Margin="0,8,0,0"
                                                       Foreground="{DynamicResource FgFaintBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtNatTitle" Text="Noch nicht gemessen"
                                                   Style="{StaticResource H2}" FontSize="18"/>
                                        <TextBlock x:Name="TxtNatBehaviour" Style="{StaticResource Caption}"
                                                   Margin="0,4,0,0" Text="Verhalten unbekannt"/>
                                        <ItemsControl x:Name="ItemsNatReasons" Margin="0,12,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                        <Ellipse Width="4" Height="4" Margin="2,8,9,0"
                                                                 VerticalAlignment="Top"
                                                                 Fill="{DynamicResource AccentBrush}"/>
                                                        <TextBlock Text="{Binding}" Style="{StaticResource Body}"
                                                                   MaxWidth="640" HorizontalAlignment="Left"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                            <Button x:Name="BtnNatStart" Style="{StaticResource AccentButton}"
                                                    Content="Messung starten"/>
                                            <Button x:Name="BtnNatCopy" Style="{StaticResource GhostButton}"
                                                    Content="Bericht kopieren" Margin="10,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,14,12,0">
                                <StackPanel>
                                    <TextBlock Text="Antworten der STUN-Server" Style="{StaticResource H2}"/>
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,10"
                                               Text="Alle Anfragen laufen über denselben lokalen Socket - nur so ist der Vergleich aussagekräftig."/>
                                    <ListView x:Name="LstNatServers" Style="{StaticResource PlainList}"
                                              ItemContainerStyle="{StaticResource ResultRow}" MaxHeight="240">
                                        <ListView.View>
                                            <GridView ColumnHeaderContainerStyle="{StaticResource ResultHeader}">
                                                <GridViewColumn Header="Server" Width="240">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Server}" Margin="12,7" FontSize="12"
                                                                       Foreground="{DynamicResource FgBrush}"/>
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                                <GridViewColumn Header="Sieht dich als" Width="220">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Margin="12,7" FontSize="12"
                                                                       FontFamily="Cascadia Mono, Consolas"
                                                                       Foreground="{DynamicResource AccentBrush}"
                                                                       Text="{Binding Endpoint}"/>
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                    <TextBlock x:Name="TxtNatEmpty" Style="{StaticResource Caption}" Margin="12,8,0,0"
                                               Text="Noch keine Messung durchgeführt."/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,14,12,0">
                                <StackPanel>
                                    <TextBlock Text="Was die Stufen bedeuten" Style="{StaticResource H2}"/>
                                    <TextBlock Style="{StaticResource Body}" Margin="0,10,0,0"
                                               Text="OFFEN - kein NAT oder vollständig durchgereichte Ports. Alles funktioniert, du kannst Gastgeber sein."/>
                                    <TextBlock Style="{StaticResource Body}" Margin="0,6,0,0"
                                               Text="MODERAT - gutmütiges NAT. Spielen klappt; Gastgeber-Rolle und manche Verbindungen brauchen eine Portfreigabe."/>
                                    <TextBlock Style="{StaticResource Body}" Margin="0,6,0,0"
                                               Text="STRIKT - streng oder CGNAT. Häufige Verbindungsabbrüche, lange Suche nach Mitspielern, kein Gastgeber."/>
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,12,0,0" TextWrapping="Wrap"
                                               Text="Ehrlich dazugesagt: messbar ist das Mapping-Verhalten (RFC 5780). Das Filter-Verhalten - wer zurückschicken darf - lässt sich ohne Server mit zweiter IP-Adresse nicht bestimmen. Deshalb steht bei gutmütigem NAT hier MODERAT und nicht vorschnell OFFEN."/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ===================== NETZWERK ===================== -->
                    <ScrollViewer x:Name="PageNetwork" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                                  Padding="28,24,20,24">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Netzwerk" Style="{StaticResource H1}"/>
                                    <TextBlock Style="{StaticResource Body}" Margin="0,6,0,0"
                                               Text="Adapter, Router und UPnP-Fähigkeit deines Anschlusses."/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                            Margin="0,0,12,0">
                                    <Button x:Name="BtnUpnpScan" Style="{StaticResource GhostButton}"
                                            Content="UPnP suchen" Margin="0,0,8,0"/>
                                    <Button x:Name="BtnNetRefresh" Style="{StaticResource GhostButton}"
                                            Content="Aktualisieren"/>
                                </StackPanel>
                            </Grid>

                            <Border Style="{StaticResource Card}" Margin="0,18,12,0">
                                <StackPanel>
                                    <TextBlock Text="Anschluss" Style="{StaticResource H2}"/>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Rechnername"
                                                   Style="{StaticResource Body}" Margin="0,0,0,7"/>
                                        <TextBlock x:Name="TxtNetHost" Grid.Row="0" Grid.Column="1" Text="..."
                                                   Style="{StaticResource Mono}" FontSize="12" Margin="0,0,0,7"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Standard-Gateway"
                                                   Style="{StaticResource Body}" Margin="0,0,0,7"/>
                                        <TextBlock x:Name="TxtNetGateway" Grid.Row="1" Grid.Column="1" Text="..."
                                                   Style="{StaticResource Mono}" FontSize="12" Margin="0,0,0,7"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="DNS-Server"
                                                   Style="{StaticResource Body}" Margin="0,0,0,7"/>
                                        <TextBlock x:Name="TxtNetDns" Grid.Row="2" Grid.Column="1" Text="..."
                                                   Style="{StaticResource Mono}" FontSize="12" Margin="0,0,0,7"/>
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Öffentliche IP"
                                                   Style="{StaticResource Body}"/>
                                        <TextBlock x:Name="TxtNetPublic" Grid.Row="3" Grid.Column="1" Text="..."
                                                   Style="{StaticResource Mono}" FontSize="12"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,14,12,0">
                                <StackPanel>
                                    <TextBlock Text="Netzwerkadapter" Style="{StaticResource H2}"/>
                                    <ItemsControl x:Name="ItemsAdapters" Margin="0,12,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8"
                                                        Padding="14,11" Margin="0,0,0,8"
                                                        BorderBrush="{DynamicResource StrokeSoftBrush}" BorderThickness="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                                       FontSize="13"
                                                                       Foreground="{DynamicResource FgBrush}"/>
                                                            <TextBlock Text="{Binding Description}" FontSize="11"
                                                                       Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                                                       Foreground="{DynamicResource FgFaintBrush}"/>
                                                            <TextBlock Text="{Binding MacAddress}" FontSize="11"
                                                                       Margin="0,3,0,0"
                                                                       FontFamily="Cascadia Mono, Consolas"
                                                                       Foreground="{DynamicResource FgFaintBrush}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                            <TextBlock Text="{Binding IPv4}"
                                                                       FontFamily="Cascadia Mono, Consolas" FontSize="13"
                                                                       HorizontalAlignment="Right"
                                                                       Foreground="{DynamicResource AccentBrush}"/>
                                                            <TextBlock Text="{Binding SpeedText}" FontSize="11"
                                                                       Margin="0,3,0,0" HorizontalAlignment="Right"
                                                                       Foreground="{DynamicResource FgFaintBrush}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,14,12,0">
                                <StackPanel>
                                    <TextBlock Text="UPnP / SSDP" Style="{StaticResource H2}"/>
                                    <TextBlock Style="{StaticResource Body}" Margin="0,6,0,10"
                                               Text="Antwortet dein Router hier, kann er Ports auf Zuruf selbst freigeben. Viele Spiele nutzen das automatisch - dann sparst du dir die Handarbeit im Router."/>
                                    <TextBlock x:Name="TxtUpnpState" Style="{StaticResource Mono}" FontSize="13"
                                               Text="Noch nicht gesucht."/>
                                    <ItemsControl x:Name="ItemsUpnp" Margin="0,10,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8"
                                                        Padding="14,11" Margin="0,0,0,8"
                                                        BorderBrush="{DynamicResource StrokeSoftBrush}" BorderThickness="1">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Address}"
                                                                   FontFamily="Cascadia Mono, Consolas"
                                                                   FontSize="13" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource AccentBrush}"/>
                                                        <TextBlock Text="{Binding Server}" FontSize="11" Margin="0,3,0,0"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource FgDimBrush}"/>
                                                        <TextBlock Text="{Binding Location}" FontSize="11" Margin="0,2,0,0"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource FgFaintBrush}"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ===================== EINSTELLUNGEN ===================== -->
                    <ScrollViewer x:Name="PageSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                                  Padding="28,24,20,24">
                        <StackPanel>
                            <TextBlock Text="Einstellungen" Style="{StaticResource H1}"/>
                            <TextBlock Style="{StaticResource Body}" Margin="0,6,0,18"
                                       Text="Wird sofort gespeichert und beim nächsten Start wieder geladen."/>

                            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="Aussehen" Style="{StaticResource H2}"/>
                                    <TextBlock Text="FARBWELT" Style="{StaticResource Label}" Margin="0,14,0,6"/>
                                    <ItemsControl x:Name="ItemsThemes" ItemTemplate="{StaticResource ThemeTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,14,12,0">
                                <StackPanel>
                                    <TextBlock Text="Testverhalten" Style="{StaticResource H2}"/>

                                    <Grid Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="260"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                            <TextBlock Text="Pause zwischen zwei Ports"
                                                       Style="{StaticResource Body}"
                                                       Foreground="{DynamicResource FgBrush}"/>
                                            <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0"
                                                       Text="Der externe Dienst begrenzt Anfragen. Zu wenig Pause führt zu Fehlern statt zu schnelleren Ergebnissen."/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtDelayValue" Text="1200 ms"
                                                       Style="{StaticResource Mono}" FontSize="13"
                                                       HorizontalAlignment="Right"/>
                                            <Slider x:Name="SldDelay" Minimum="300" Maximum="4000" Value="1200"
                                                    TickFrequency="100" IsSnapToTickEnabled="True" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <Border Height="1" Background="{DynamicResource StrokeSoftBrush}" Margin="0,18,0,18"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="260"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                            <TextBlock Text="Zeitlimit je Anfrage" Style="{StaticResource Body}"
                                                       Foreground="{DynamicResource FgBrush}"/>
                                            <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0"
                                                       Text="Wie lange auf die Antwort des Dienstes gewartet wird."/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtTimeoutValue" Text="20 s"
                                                       Style="{StaticResource Mono}" FontSize="13"
                                                       HorizontalAlignment="Right"/>
                                            <Slider x:Name="SldTimeout" Minimum="5" Maximum="60" Value="20"
                                                    TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <Border Height="1" Background="{DynamicResource StrokeSoftBrush}" Margin="0,18,0,18"/>

                                    <CheckBox x:Name="ChkListener" IsChecked="True"
                                              Content="Während des Tests kurz einen lokalen Listener öffnen"/>
                                    <TextBlock Style="{StaticResource Caption}" Margin="30,5,0,0" TextWrapping="Wrap"
                                               Text="Empfohlen. Ohne Listener meldet selbst eine korrekt eingerichtete Portweiterleitung 'geschlossen', weil niemand die Verbindung annimmt. Windows fragt dabei ggf. nach einer Firewall-Freigabe - diese muss erlaubt werden."/>

                                    <CheckBox x:Name="ChkWarnLarge" IsChecked="True" Margin="0,14,0,0"
                                              Content="Bei sehr vielen Ports vorher nachfragen"/>
                                    <TextBlock Style="{StaticResource Caption}" Margin="30,5,0,0" TextWrapping="Wrap"
                                               Text="Schützt davor, versehentlich einen Test zu starten, der Stunden dauert."/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,14,12,0">
                                <StackPanel>
                                    <TextBlock Text="Daten" Style="{StaticResource H2}"/>
                                    <TextBlock x:Name="TxtSettingsPath" Style="{StaticResource Caption}"
                                               Margin="0,8,0,12" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="BtnOpenSettingsFolder" Style="{StaticResource GhostButton}"
                                                Content="Ordner öffnen" Margin="0,0,8,0"/>
                                        <Button x:Name="BtnResetSettings" Style="{StaticResource DangerButton}"
                                                Content="Auf Standard zurücksetzen"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ===================== ÜBER ===================== -->
                    <ScrollViewer x:Name="PageAbout" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                                  Padding="28,24,20,24">
                        <StackPanel>
                            <TextBlock Text="Über &amp; Hilfe" Style="{StaticResource H1}"/>

                            <Border Style="{StaticResource Card}" Margin="0,16,12,0">
                                <StackPanel>
                                    <TextBlock Text="Wie der Test funktioniert" Style="{StaticResource H2}"/>
                                    <TextBlock Style="{StaticResource Body}" Margin="0,10,0,0"
                                               Text="1. PortCheck öffnet auf deinem Rechner kurz einen lokalen Listener auf dem Port, der geprüft werden soll."/>
                                    <TextBlock Style="{StaticResource Body}" Margin="0,6,0,0"
                                               Text="2. Ein Dienst außerhalb deines Netzes versucht, sich von außen auf deine öffentliche IP und genau diesen Port zu verbinden."/>
                                    <TextBlock Style="{StaticResource Body}" Margin="0,6,0,0"
                                               Text="3. Kommt die Verbindung zustande, ist der Port offen - Router-Weiterleitung und Firewall stimmen. Sonst ist er zu."/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,14,12,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72E;" FontSize="14"
                                                   Foreground="{DynamicResource WarnBrush}"/>
                                        <TextBlock Text="Was nach außen geht" Style="{StaticResource H2}"
                                                   Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Body}" Margin="0,10,0,0"
                                               Text="Port-Test: deine öffentliche IP und die Portnummer gehen an ports.yougetsignal.com, ersatzweise an canyouseeme.org. Ohne einen Rechner außerhalb deines Netzes ist so ein Test nicht möglich."/>
                                    <TextBlock Style="{StaticResource Body}" Margin="0,6,0,0"
                                               Text="IP-Ermittlung: eine Anfrage an api.ipify.org (ersatzweise ifconfig.me, checkip.amazonaws.com, icanhazip.com). Diese Dienste sehen nur, was jeder Webserver sieht."/>
                                    <TextBlock Style="{StaticResource Body}" Margin="0,6,0,0"
                                               Text="NAT-Test: leere STUN-Anfragen an öffentliche Server von Google, Cloudflare, Nextcloud und sipgate. Es werden dabei keine Inhalte übertragen."/>
                                    <TextBlock Style="{StaticResource Body}" Margin="0,6,0,0"
                                               Text="UPnP-Suche: bleibt vollständig in deinem lokalen Netz. Sonst gibt es keine Telemetrie, keine Konten, keine Werbung - der Quelltext liegt vollständig bei."/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,14,12,0">
                                <StackPanel>
                                    <TextBlock Text="Häufige Ursachen, wenn alles geschlossen ist"
                                               Style="{StaticResource H2}"/>
                                    <TextBlock Style="{StaticResource Body}" Margin="0,10,0,0"
                                               Text="- Keine Portweiterleitung im Router eingerichtet, oder auf die falsche lokale IP."/>
                                    <TextBlock Style="{StaticResource Body}" Margin="0,4,0,0"
                                               Text="- Die Windows-Firewall-Abfrage wurde weggeklickt oder blockiert."/>
                                    <TextBlock Style="{StaticResource Body}" Margin="0,4,0,0"
                                               Text="- Dein Anbieter nutzt CGNAT oder DS-Lite. Dann ist Portweiterleitung technisch unmöglich, egal was im Router steht - erkennbar am NAT-Test."/>
                                    <TextBlock Style="{StaticResource Body}" Margin="0,4,0,0"
                                               Text="- Zwei Router hintereinander (doppeltes NAT). Der äußere muss in den Bridge-Modus, oder die Weiterleitung muss in beiden stehen."/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,14,12,0">
                                <StackPanel>
                                    <TextBlock Text="Projekt" Style="{StaticResource H2}"/>
                                    <TextBlock x:Name="TxtAboutVersion" Style="{StaticResource Body}" Margin="0,10,0,0"/>
                                    <TextBlock Style="{StaticResource Body}" Margin="0,4,0,0"
                                               Text="Lizenz: MIT - frei nutzbar, veränderbar und weitergebbar."/>
                                    <TextBlock Style="{StaticResource Body}" Margin="0,4,0,12"
                                               Text="Reines PowerShell mit WPF. Kein Installer, keine kompilierte Datei, keine Abhängigkeiten - jede Zeile ist im Klartext nachlesbar."/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="BtnOpenRepo" Style="{StaticResource GhostButton}"
                                                Content="Projektseite öffnen" Margin="0,0,8,0"/>
                                        <Button x:Name="BtnOpenSource" Style="{StaticResource GhostButton}"
                                                Content="Quelltext-Ordner öffnen"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                </Grid>
            </Grid>

            <!-- ============================================================ -->
            <!-- Statusleiste                                               -->
            <!-- ============================================================ -->
            <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource StrokeSoftBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="7" Height="7"
                                 Fill="{DynamicResource OkBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtStatus" Text="Bereit" Margin="8,0,0,0"
                                   VerticalAlignment="Center" Style="{StaticResource Caption}"/>
                    </StackPanel>

                    <ProgressBar x:Name="ProgStatus" Grid.Column="1" Width="180" Height="3"
                                 HorizontalAlignment="Right" VerticalAlignment="Center"
                                 Margin="0,0,14,0" Visibility="Collapsed"/>

                    <TextBlock x:Name="TxtStatusRight" Grid.Column="2" VerticalAlignment="Center"
                               Style="{StaticResource Caption}" Text="TCP-Prüfung - UDP ist von außen nicht testbar"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
